// Google Form redirect with Discord identity pre-fill — generated by URLBot
var authurl  = "{{AUTH_URL}}";
var baseurl  = "{{BASE_URL}}";
var uid      = "{{UID_FIELD}}";
var user     = "{{USER_FIELD}}";

var seconds = 3;
var foo;

function redirect(p) { document.location.href = p; }

function updateSecs(p) {
    document.getElementById("countdown").innerHTML = seconds;
    seconds--;
    if (seconds === -1) { clearInterval(foo); redirect(p); }
}

function countdownTimer(p) {
    foo = setInterval(function() { updateSecs(p); }, 1000);
}

window.onload = () => {
    const fragment = new URLSearchParams(window.location.hash.slice(1));
    const accessToken = fragment.get('access_token');
    const tokenType   = fragment.get('token_type');

    if (!accessToken) {
        document.getElementById('login').style.display = 'block';
        document.getElementById('redirect').style.display = 'block';
        countdownTimer(authurl);
        return;
    }

    fetch('https://discord.com/api/users/@me', {
        headers: { authorization: `${tokenType} ${accessToken}` }
    })
    .then(r => r.json())
    .then(response => {
        const { id, username, discriminator, avatar } = response;
        const pic = `https://cdn.discordapp.com/avatars/${id}/${avatar}.png`;
        document.getElementById('info').innerText = `${username}`;
        document.getElementById('info').innerHTML += `<br><img src="${pic}">`;

        var fullpath = baseurl;
        if (uid)  fullpath += '&entry.' + uid  + '=' + encodeURIComponent(id);
        if (user) fullpath += '&entry.' + user + '=' + encodeURIComponent(`${username}#${discriminator}`);

        document.getElementById('redirect').style.display = 'block';
        document.getElementById('redirect').innerHTML +=
            ` If not redirected, click <a href="${fullpath}">here</a>.`;
        countdownTimer(fullpath);
    })
    .catch(console.error);
};
